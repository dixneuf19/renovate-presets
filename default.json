{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default Renovate preset for dixneuf19 repos",
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    ":automergeBranch"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Python minor/major base image bumps need manual review",
      "matchPackageNames": ["/python/"],
      "automerge": false
    }
  ]
}
